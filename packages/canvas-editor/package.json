{
    "name": "@hankchen/canvas-editor",
    "version": "0.1.1",
    "license": "MIT",
    "description": "headless 编辑器内核：observable store、immer patches 双栈历史、工具状态机、选择/视口/命中/吸附/物化状态机/剪贴板——仅依赖 immer",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./package.json": "./package.json"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HankChenCH/canvas-web.git",
        "directory": "packages/canvas-editor"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@hankchen/canvas": "^0.1.0",
        "@hankchen/canvas-browser-renderer": "workspace:*",
        "immer": "^11.1.18"
    },
    "devDependencies": {
        "tsup": "^8.5.0",
        "vitest": "^5.0.1"
    }
}

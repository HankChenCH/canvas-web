{
    "name": "@hankchen/canvas-browser-renderer",
    "version": "0.1.0",
    "license": "MIT",
    "description": "Canvas2D 五原语渲染后端（矩形/图片 cover/文本基线消化、字体与 QR 物化）",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./package.json": "./package.json"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HankChenCH/canvas-web.git",
        "directory": "packages/canvas-browser-renderer"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@hankchen/canvas": "^0.1.0",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@types/qrcode": "^1.5.6",
        "tsup": "^8.5.0",
        "vitest": "^5.0.1"
    }
}
